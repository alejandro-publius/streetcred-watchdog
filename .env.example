# Copy to .env for local runs. Never commit the filled-in version.
# On Cloud Run every one of these comes from Secret Manager or the service
# config, and nothing here is ever written to a file by the agent itself.

GOOGLE_CLOUD_PROJECT=streetcred-watchdog
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI. The two-tier brain: cheap reflex, expensive judgment.
TRIAGE_MODEL=gemma-3-27b-it
DELIBERATION_MODEL=gemini-3.7-flash

# The only credential shared with StreetCred, used in one direction only.
# Generate with: openssl rand -hex 32
WATCHDOG_INGEST_TOKEN=
STREETCRED_ORIGIN=https://streetcred.thealexschroeder.workers.dev

# Pub/Sub
DELTA_TOPIC=corner-deltas
DELTA_SUBSCRIPTION=corner-deltas-actor

# The agent's own daily action budget, entirely separate from StreetCred's
# public generation cap. Exhausting this converts actions into journaled
# intents rather than skipping them silently.
DAILY_ACTION_BUDGET=40
DAILY_IMAGE_BUDGET=6
